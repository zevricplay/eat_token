# Environment Configuration
NODE_ENV=production

# API Configuration
API_BASE_URL=https://api.fftools.site
API_VERSION=v1
API_TIMEOUT=30000

# OAuth Configuration
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_FACEBOOK_APP_ID=your_facebook_app_id
OAUTH_APPLE_TEAM_ID=your_apple_team_id

# Token Configuration
TOKEN_CACHE_DURATION=3600
MAX_TOKEN_LENGTH=2000
MIN_TOKEN_LENGTH=50

# UI Configuration
SITE_TITLE=Free Fire Token Generator
SITE_DESCRIPTION=The fastest Free Fire Token Generator online
SITE_LOGO_URL=/assets/logo.png

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
ENABLE_ANALYTICS=true

# Feature Flags
ENABLE_HISTORY=true
ENABLE_CLIPBOARD=true
ENABLE_NOTIFICATIONS=true
ENABLE_DARK_MODE=true

# Security
ENABLE_HTTPS_ONLY=true
SECURE_COOKIES=true
CORS_ENABLED=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600000

# Logging
LOG_LEVEL=info
ENABLE_DEBUG_MODE=false

# Maintenance
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are currently under maintenance. Please check back soon!
